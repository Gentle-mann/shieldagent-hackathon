# === Required: Anthropic API key ===
ANTHROPIC_API_KEY=sk-ant-...

# === Required for RAG embeddings ===
OPENAI_API_KEY=sk-...

# === Optional: SHISA.AI Translation (sponsor - free at hackathon) ===
SHISA_API_KEY=
SHISA_BASE_URL=https://talk.shisa.ai/v1

# === RAG Configuration (defaults are fine) ===
RAG_BACKEND=faiss
RAG_COLLECTION=labor_law
TOP_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=120
